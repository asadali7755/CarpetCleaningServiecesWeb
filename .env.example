# Web3Forms access key — get yours free at https://web3forms.com
# Enter your email (Madinatalhaya@gmail.com), they'll send the key
NEXT_PUBLIC_WEB3FORMS_KEY=your_access_key_here

# Resend.com email
RESEND_API_KEY=

# ============================================
# STRIPE — AED 50 paid quote-request checkout
